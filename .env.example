# Supabase-Anbindung. Ohne diese Werte läuft die App im lokalen Modus:
# Lernstand im Browser, Liga mit Beispieldaten. Einrichtung: docs/BACKEND.md
#
# Wichtig: beim Anlegen des Projekts als Region "Frankfurt (eu-central-1)"
# wählen. Verarbeitung ausschliesslich in EU/EWR ist bei Green Fusion
# gesetzt und gilt auch für interne Werkzeuge.
#
# Beide Werte holst du im Supabase-Dashboard über den Connect-Button
# (Framework: Vite) oder unter Settings -> API Keys.

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Der alte anon-Key funktioniert weiter, wird aber Ende 2026 von Supabase
# abgeschaltet. Nur setzen, wenn kein publishable Key vorliegt:
# VITE_SUPABASE_ANON_KEY=eyJ...

# Nur Adressen auf dieser Domain können ein Konto anlegen. Optional --
# ohne Eintrag gilt green-fusion.de. Wichtig: OHNE das @-Zeichen, sonst
# wird gegen "@@green-fusion.de" geprüft und keine Adresse kommt durch.
# VITE_ALLOWED_EMAIL_DOMAIN=green-fusion.de

# NIEMALS mit VITE_-Präfix hinterlegen: der service_role- bzw.
# sb_secret_-Key umgeht die Zeilen-Regeln vollständig. Alles mit VITE_
# landet im Browser-Bundle und ist damit öffentlich.
